# 웹 PC 설정 — 이 파일을 .env 로 복사해 값을 넣는다. .env 는 커밋하지 않는다(PR 검사가 막음, 팀 규칙 4)
MQTT_HOST=localhost
MQTT_PORT=1883
# 비우면 저장소의 src/d2_robot/d2_bringup/config/robot.yaml (컨테이너에서는 읽기 전용으로 연결한 경로)
ROBOT_YAML=
# 설계 · 조립 기록 폴더(비우면 web/backend/data — 커밋 안 됨). 기본 설계 레시피 폴더(비우면 저장소 d2_bringup/recipes)
DATA_DIR=
RECIPE_DIR=
# 키 값은 여기(.env)에만. 코드 · 기록 · 채팅에 쓰지 않는다. 설계 생성은 Claude(중계 claude_bridge)라 이 키는 음성 STT(Whisper)만 쓴다
OPENAI_API_KEY=
# 설계 생성 Claude 모델(opus · sonnet — 비우면 opus). 중계 주소 D2_LLM_URL 은 compose 가 정한다(호스트 직접 실행이면 127.0.0.1:8790)
D2_LLM_MODEL=
