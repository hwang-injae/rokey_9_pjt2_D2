llColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1442.0" y="781.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.in2" value="&lt;b&gt;MQTT d2/task/state (retained)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;상태 · 블록 · 알림 글&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1442.0" y="848.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="backend.in3" value="&lt;b&gt;MQTT d2/task/progress (retained)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;진행표&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1442.0" y="916.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="backend.in4" value="&lt;b&gt;MQTT d2/task/scan_result (retained)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;추론 설계 · 사진 → 비교 화면&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1442.0" y="984.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="backend.in5" value="&lt;b&gt;MQTT d2/safety/state (retained)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;멈춤 · 잠금&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1442.0" y="1052.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="backend.in6" value="&lt;b&gt;MQTT d2/gripper/state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;쥔 블록&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1442.0" y="1120.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="backend.in7" value="&lt;b&gt;MQTT check_design/res&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;통과 · 이유 · 구조 · 레시피 (req_id 짝)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1442.0" y="1173.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.in8" value="&lt;b&gt;OpenAI GPT-4o&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;HTTPS · 구조화 출력 · 키는 .env&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1442.0" y="1240.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="backend.in9" value="&lt;b&gt;MQTT d2/hmi/get_design/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design_id (로봇 PC가 물음)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1442.0" y="1293.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="backend.in10" value="&lt;b&gt;MQTT d2/hmi/save_build/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;조립 결과 build/1 → builds (같은 run_id는 한 번만)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;