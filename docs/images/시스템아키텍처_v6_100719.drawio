th="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="task.grp0" value="&lt;b&gt;클래스 TaskManager — 상태표 (조립 · 공급 · 스캔 · 정지 · 시간 제한)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="2298.0" width="512.0" height="436.0" as="geometry"/></mxCell><mxCell id="task.grp1" value="&lt;b&gt;클래스 TaskPlanner — 작업 판단 + BlockPicker — 집을 블록 고르기&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="2742.0" width="512.0" height="191.0" as="geometry"/></mxCell><mxCell id="task.grp2" value="&lt;b&gt;클래스 DesignChecker — 검사 묶음 (ROS 없음)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="2941.0" width="512.0" height="126.0" as="geometry"/></mxCell><mxCell id="task.grp3" value="&lt;b&gt;클래스 RunLogger — 기록&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="3075.0" width="512.0" height="76.0" as="geometry"/></mxCell><mxCell id="task.in0" value="&lt;b&gt;/d2/hmi/command (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;select_design · start · scan · cancel · [계속] = start — 다리가 부름&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="2298.0" width="210.0" height="71.0