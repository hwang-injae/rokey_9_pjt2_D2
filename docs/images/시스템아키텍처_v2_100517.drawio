<mxfile host="app.diagrams.net"><diagram name="아키텍처 v2" id="d2arch2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="5390" pageHeight="2837"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;젠가 블록 가구 협동로봇 — 시스템 아키텍처 v2 (1차 · 10/5 결정 기준) · PC 2대 · 노드 9개 · 컨테이너 2개(+DB 1차 뒤)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40.0" y="14.0" width="5270.0" height="40.0" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b7c1cc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30.0" y="60.0" width="5290.0" height="390.0" as="geometry"/></mxCell><mxCell id="leg1t" value="&lt;b&gt;① 화살표 색 = 데이터 갈래&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50.0" y="70.0" width="500.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg1e0" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1f4fd6;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="120.0" as="sourcePoint"/><mxPoint x="150.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l0" value="명령 — 화면·음성 → 작업 관리자" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="107.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e1" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#a020c0;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="120.0" as="sourcePoint"/><mxPoint x="750.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l1" value="표시 — 작업 관리자 → 화면" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="764.0" y="107.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e2" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1e9e3e;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="120.0" as="sourcePoint"/><mxPoint x="1350.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l2" value="관측·진행표 — 카메라 확인 · 진행표" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1364.0" y="107.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e3" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#111111;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="154.0" as="sourcePoint"/><mxPoint x="150.0" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l3" value="동작 — 작업 관리자 → 집기·놓기 → 그리퍼·장면·MoveIt2" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="141.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e4" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#e00000;strokeWidth=3.8000000000000003;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="154.0" as="sourcePoint"/><mxPoint x="750.0" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l4" value="정지 — 정지 버튼 → 정지 노드 → 모두 · 제어기" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="764.0" y="141.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e5" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#a8a8a8;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="154.0" as="sourcePoint"/><mxPoint x="1350.0" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l5" value="장치·이미 있는 노드 — USB · 제어기 · Modbus · /joint_states" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1364.0" y="141.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2t" value="&lt;b&gt;② 선 모양&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50.0" y="204.0" width="300.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg2a" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="254.0" as="sourcePoint"/><mxPoint x="150.0" y="254.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2al" value="실선 = 1차(10/7까지) 만드는 연결" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="241.0" width="900.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2b" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;strokeWidth=2.4;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="288.0" as="sourcePoint"/><mxPoint x="150.0" y="288.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2bl" value="점선 = 1차 뒤(10/8~) · 챌린지에 붙일 연결 (점선 테두리 상자 = 나중에 만들 노드)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="275.0" width="1100.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2v" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="308.0" as="sourcePoint"/><mxPoint x="105.0" y="352.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2h" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1f4fd6;strokeWidth=2.4;jumpStyle=arc;jumpSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="330.0" as="sourcePoint"/><mxPoint x="150.0" y="330.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2hl" value="다리 = 선이 겹치는 곳(서로 이어진 게 아님)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="317.0" width="900.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2i" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1e9e3e;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="370.0" as="sourcePoint"/><mxPoint x="120.0" y="386.0" as="targetPoint"/><Array as="points"><mxPoint x="90.0" y="370.0"/><mxPoint x="90.0" y="386.0"/></Array></mxGeometry></mxCell><mxCell id="leg2il" value="카드 안 가는 선 = 입력이 어느 처리로 가고, 어느 처리가 출력을 내는지(색 = 들어온 화살표 색)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="364.0" width="1100.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3t" value="&lt;b&gt;③ 상자 종류&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1290.0" y="204.0" width="300.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg3b0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a0;" vertex="1" parent="1"><mxGeometry x="1300.0" y="244.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l0" value="노드 카드 — 우리가 만드는 노드 (머리띠 색 = 파트)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="242.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3e7ec;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300.0" y="274.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l1" value="이미 있는 노드 — 설치해서 씀" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="272.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#666666;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1300.0" y="304.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l2" value="1차 뒤에 만들 노드" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="302.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300.0" y="334.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l3" value="장치 — 노드 아님(하드웨어)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="332.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;dashed=1;dashPattern=8 5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300.0" y="364.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l4" value="컨테이너(Docker) — 안의 노드가 이 상자에서 돈다" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="362.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="1300.0" y="394.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l5" value="클래스 — 노드 안의 코드 묶음" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="392.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg4t" value="&lt;b&gt;④ 낱말&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2190.0" y="70.0" width="300.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg4_0" value="&lt;b&gt;노드&lt;/b&gt;&amp;nbsp;&amp;nbsp; 실행되는 프로그램 하나(ROS 2 노드). ros2 run으로 켠다. 이 그림의 카드 하나" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="104.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_1" value="&lt;b&gt;패키지&lt;/b&gt;&amp;nbsp;&amp;nbsp; 노드들을 담은 폴더(d2_hmi · d2_task …). 카드 오른쪽 위 글자" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="142.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_2" value="&lt;b&gt;클래스&lt;/b&gt;&amp;nbsp;&amp;nbsp; 노드 안의 코드 묶음. task 노드 안의 TaskManager · TaskPlanner · RunLogger" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="180.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_3" value="&lt;b&gt;컨테이너&lt;/b&gt;&amp;nbsp;&amp;nbsp; Docker 상자. 라이브러리 충돌을 막고 어느 PC에서나 같은 환경으로 돌린다(성능은 그대로). 1차: 화면 · 웹캠" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="218.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_4" value="&lt;b&gt;토픽&lt;/b&gt;&amp;nbsp;&amp;nbsp; 방송 — 보내고 끝, 답 없음. 여러 곳이 계속 봐야 하는 상태 · 진행표" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="256.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_5" value="&lt;b&gt;서비스&lt;/b&gt;&amp;nbsp;&amp;nbsp; 부탁 → 답 한 번. 짧은 일(명령 · 확인 · 그리퍼)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="294.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_6" value="&lt;b&gt;액션&lt;/b&gt;&amp;nbsp;&amp;nbsp; 부탁 → 중간 보고 → 결과, 도중 취소 가능. 블록 1개 옮기기" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="332.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4n" value="서비스 · 액션 화살표는 부탁하는 방향으로만 그렸다. 답은 같은 길로 돌아온다." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="2200.0" y="370.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="layer_svc" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f0f7;strokeColor=#a05195;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="30.0" y="480.0" width="5290.0" height="897.0" as="geometry"/></mxCell><mxCell id="layer_svc_t" value="&lt;b&gt;서비스 PC (안: 성능 좋은 GPU PC) — 컨테이너 2개(화면 · 웹캠) + 호스트에서 바로 실행(음성 · 작업 관리자) · host 네트워크 · CycloneDDS · ROS_DOMAIN_ID 60&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a05195;strokeColor=none;fontColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="480.0" width="2100.0" height="38.0" as="geometry"/></mxCell><mxCell id="layer_robot" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#eef1fb;strokeColor=#5566b5;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="30.0" y="1669.0" width="5290.0" height="790.0" as="geometry"/></mxCell><mxCell id="layer_robot_t" value="&lt;b&gt;로봇 PC (안: 중간 GPU PC) — 컨테이너 없이 호스트에서 바로 실행 · 제어기와 유선 · 손목 카메라 USB&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5566b5;strokeColor=none;fontColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="1669.0" width="2100.0" height="38.0" as="geometry"/></mxCell><mxCell id="layer_dev" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ecf6f0;strokeColor=#2e8b7a;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="30.0" y="2607.0" width="5290.0" height="160.0" as="geometry"/></mxCell><mxCell id="layer_dev_t" value="&lt;b&gt;로봇 · 장치 (노드 아님 — 하드웨어)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e8b7a;strokeColor=none;fontColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="2607.0" width="2100.0" height="38.0" as="geometry"/></mxCell><mxCell id="ctr_hmi" value="&lt;b&gt;[Docker] 컨테이너 hmi — 웹 화면 (웹 서버 라이브러리 분리)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#1565c0;strokeWidth=2.5;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="168.0" y="532.0" width="876.0" height="380.0" as="geometry"/></mxCell><mxCell id="ctr_vision" value="&lt;b&gt;[Docker] 컨테이너 vision — 웹캠 (numpy 충돌 분리)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#1565c0;strokeWidth=2.5;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="3564.0" y="532.0" width="836.0" height="260.0" as="geometry"/></mxCell><mxCell id="ctr_db" value="&lt;b&gt;[Docker] 컨테이너 db-hmi — DB (1차 뒤)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#1565c0;strokeWidth=2.5;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="4666.0" y="532.0" width="384.0" height="124.0" as="geometry"/></mxCell><mxCell id="voice_stop" value="&lt;b&gt;[노드(1차 뒤)] voice_stop — 음성 &#x27;멈춰&#x27; (1차 뒤 W046)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;PC 안 키워드 → safety/stop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1332.0" y="1273.0" width="400.0" height="74.0" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;[노드(1차 뒤)] DB · 대시보드 (1차 뒤 W051 · W088)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;작업 관리자 CSV → DB → 화면&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#666666;strokeWidth=1.5;align=lef