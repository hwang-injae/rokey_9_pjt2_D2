="&lt;b&gt;/d2/motion/pick_place (액션)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;블록 1개 목표&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2154.0" y="2388.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="task.out4" value="&lt;b&gt;/d2/vision/scan_capture · scan_infer (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;촬영 · 추론 요청&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2154.0" y="2441.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="task.out5" value="&lt;b&gt;/d2/task/state (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;상태 · 알림 글(공급 채우기 · 정지 이유 · 완성)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2154.0" y="2509.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="task.out6" value="&lt;b&gt;/d2/task/progress (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;진행표 → 장면 관리 · 다리 → 화면&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2154.0" y="2576.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="task.out7" value="&lt;b&gt;/d2/task/scan_result (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;추론 설계 → 다리 → 화면 비교&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2154.0" y="2629.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="task.out8" value="&lt;b&gt;check_design 답&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;통과 · 이유 · 구조 · 레시피&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2154.0" y="2682.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="task.out9" value="&lt;b&gt;/d2/hmi/save_build (서비스, 안)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;조립 결과(성공 · 오차 · 시간) → 다리&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2154.0" y="2735.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="task.st0" value="① 명령 받기: 설계 선택 → get_design으로 레시피, 출발(버튼 · 음성 같게), 스캔, [계속]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2224.0" width="470.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st1" value="② 시작 점검(로봇 · 그리퍼 · 카메라 · 다리 연결 · 조립 자리 · 공급) → 관측 자세 move_to(observe)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2274.0" width="470.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st2" value="③ 확인 부탁 check_progress(설계 이름 · 블록 이름) → 답을 TaskPlanner에" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2324.0" width="470.0" height="25.0" as="geometry"/></mxCell><mxCell id="task.st3" value="④ 다음 블록을 pick_place 목표로 → 결과 → 블록마다 ②③. 공급 칸이 다 비면 WAIT_SUPPLY 알림 → [계속]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2359.0" width="470.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st4" value="⑤ 스캔: observe → observe_front(→ side) 자세마다 scan_capture → scan_infer → scan_result 방송" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2409.0" width="470.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st5" value="⑥ 멈춤이면 STOPPED → 다시 시작 → 쥔 블록 확인 → 진행 확인부터. 웹 끊김(안)이면 현재 블록까지 놓고 WAIT" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2459.0" width="470.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st6" value="⑦ 관측 결과 ↔ 레시피(블록 이름 역할_부품_블록) → 진행표(있음 · 없음 · 높이 · 오차 측정값) → progress 방송" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2543.0" width="470.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st7" value="⑧ 다음 블록 = sequence 첫 미배치(받침 있음) · 설계 좌표 + 조립 원점 → 로봇 좌표" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2593.0" width="470.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st8" value="⑨ 블록 JSON 검사: 형식 · 파고듦 · 받침 · 안정성(무게중심 여유 7 mm, 쌓는 도중) · 잡기 틈 · 막힌 칸 · 작업영역" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2677.0" width="470.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st9" value="⑩ 통과면 변환기 ①(blocks_to_recipe, 레시피 도구) → 구조 + 레시피 → 답(통과 · 이유 · 구조 · 레시피)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2727.0" width="470.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st10" value="⑪ run_id CSV 직접 쓰기 → 끝나면 save_build(다리 → 웹)로 builds" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2811.0" width="470.0" height="25.0" as="geometry"/></mxCell><mxCell id="task.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;" edge="1" parent="1" source="task.in0" target="task.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1602.0" y="2228.5"/><mxPoint x="1602.0" y="2236.0"/></Array></mxGeometry></mxCell><mxCell id="task.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;" edge="1" parent="1" source="task.in1" target="task.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1610.0" y="2295.5"/><mxPoint x="1610.0" y="2236.0"/></Array></mxGeometry></mxCell><mxCell id="task.c2" style="edgeStyle=none;ro