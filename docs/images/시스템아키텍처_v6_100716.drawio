Cell id="task.meta" value="비전 · 패키지 d2_task&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#5566b5&quot;&gt;돌리는 곳: 호스트&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2014.0" y="2124.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="task.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1382.0" y="2174.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="task.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2174.0" width="470.0" height="22.0" as="geometry"/></mxCell><mxCell id="task.col782" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="2154.0" y="2174.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="task.grp0" value="&lt;b&gt;클래스 TaskManager — 상태표 (조립 · 스캔 · 공급 · 정지)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="2200.0" width="482.0" height="311.0" as="geometry"/></mxCell><mxCell id="task.grp1" value="&lt;b&gt;클래스 TaskPlanner — 작업 판단 (진행표 · 다음 블록)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="2519.0" width="482.0" height="126.0" as="geometry"/></mxCell><mxCell id="task.grp2" value="&lt;b&gt;클래스 DesignChecker — 검사 묶음 (ROS 없음)&lt;/b&gt;" style="round