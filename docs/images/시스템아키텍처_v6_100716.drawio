<mxfile host="app.diagrams.net"><diagram name="아키텍처 v3" id="d2arch3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="7914" pageHeight="4056"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AI가 설계하고 로봇이 조립하는 젠가 가구 — 시스템 아키텍처 v6 (10/7 기술 스택 v2: frontend(Next.js 정적 + three.js, 브라우저) · backend(FastAPI :8000 · WebSocket) · PostgreSQL 16 · Whisper) · 웹 PC(ROS 없음) + 로봇 PC(ROS 노드 8개 + 다리) · 컨테이너 3개(mosquitto · db · web) · PC 사이 MQTT&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40.0" y="14.0" width="7794.0" height="40.0" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b7c1cc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30.0" y="60.0" width="7814.0" height="390.0" as="geometry"/></mxCell><mxCell id="leg1t" value="&lt;b&gt;① 화살표 색 = 데이터 갈래&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50.0" y="70.0" width="500.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg1e0" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1f4fd6;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="120.0" as="sourcePoint"/><mxPoint x="150.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l0" value="명령 — 화면·음성 → 작업 관리자" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="107.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e1" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#a020c0;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="120.0" as="sourcePoint"/><mxPoint x="750.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l1" value="표시 — 작업 관리자·그리퍼 → 화면" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="764.0" y="107.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e2" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#e08a00;strokeWidth=3.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="120.0" as="sourcePoint"/><mxPoint x="1350.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l2" value="설계 — 생성 · 검사(check_design) · 설계 꺼내기(get_design) · 저장(블록 JSON · 레시피 = 구조 + 조립)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1364.0" y="107.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e3" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1e9e3e;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="154.0" as="sourcePoint"/><mxPoint x="150.0" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l3" value="관측·스캔·진행표 — 카메라 확인 · 스캔 추론 · 진행표" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="141.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e4" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#111111;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="154.0" as="sourcePoint"/><mxPoint x="750.0" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l4" value="동작 — 작업 관리자 → 집기·놓기 → 그리퍼·장면·MoveIt2" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="764.0" y="141.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e5" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#e00000;strokeWidth=3.8000000000000003;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="154.0" as="sourcePoint"/><mxPoint x="1350.0" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l5" value="정지 — 정지 버튼 → 정지 노드 → 모두 · 제어기" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1364.0" y="141.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e6" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#a8a8a8;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="188.0" as="sourcePoint"/><mxPoint x="150.0" y="188.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l6" value="장치·바깥·생존 신호 — USB · 제어기 · Modbus · /joint_states · OpenAI · alive" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="175.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2t" value="&lt;b&gt;② 선 모양&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50.0" y="204.0" width="300.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg2a" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="254.0" as="sourcePoint"/><mxPoint x="150.0" y="254.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2al" value="실선 = 1차 · 핵심(10/13 동결까지) 만드는 연결" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="241.0" width="900.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2b" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;strokeWidth=2.4;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="288.0" as="sourcePoint"/><mxPoint x="150.0" y="288.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2bl" value="점선 = 나중에(핵심 뒤 남으면) 붙일 연결 (점선 테두리 상자 = 나중에 만들 노드)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="275.0" width="1100.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2v" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="308.0" as="sourcePoint"/><mxPoint x="105.0" y="352.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2h" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1f4fd6;strokeWidth=2.4;jumpStyle=arc;jumpSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="330.0" as="sourcePoint"/><mxPoint x="150.0" y="330.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2hl" value="다리 = 선이 겹치는 곳(서로 이어진 게 아님)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="317.0" width="900.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2i" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1e9e3e;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="370.0" as="sourcePoint"/><mxPoint x="120.0" y="386.0" as="targetPoint"/><Array as="points"><mxPoint x="90.0" y="370.0"/><mxPoint x="90.0" y="386.0"/></Array></mxGeometry></mxCell><mxCell id="leg2il" value="카드 안 가는 선 = 입력이 어느 처리로 가고, 어느 처리가 출력을 내는지(색 = 들어온 화살표 색)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="364.0" width="1100.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3t" value="&lt;b&gt;③ 상자 종류&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1290.0" y="204.0" width="300.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg3b0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a0;" vertex="1" parent="1"><mxGeometry x="1300.0" y="244.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l0" value="노드 카드 — 우리가 만드는 노드 (머리띠 색 = 파트)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="242.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3e7ec;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300.0" y="274.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l1" value="이미 있는 노드 — 설치해서 씀" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="272.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#666666;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1300.0" y="304.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l2" value="나중에 만들 노드" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="302.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300.0" y="334.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l3" value="저장소(DB) · 라이브러리(노드 아님)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="332.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300.0" y="364.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l4" value="장치 — 노드 아님(하드웨어)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="362.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;dashed=1;dashPattern=8 5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300.0" y="394.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l5" value="컨테이너(Docker) — 안의 노드가 이 상자에서 돈다" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="392.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="1300.0" y="424.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l6" value="클래스 — 노드 안의 코드 묶음" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="422.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg4t" value="&lt;b&gt;④ 낱말&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2190.0" y="70.0" width="300.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg4_0" value="&lt;b&gt;노드&lt;/b&gt;&amp;nbsp;&amp;nbsp; 실행되는 프로그램 하나(ROS 2 노드). ros2 run으로 켠다. 이 그림의 카드 하나" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="104.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_1" value="&lt;b&gt;패키지&lt;/b&gt;&amp;nbsp;&amp;nbsp; 노드들을 담은 폴더(d2_task · d2_bridge …). 웹 코드는 web/(ROS 아님). 카드 오른쪽 위 글자" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="142.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_2" value="&lt;b&gt;클래스&lt;/b&gt;&amp;nbsp;&amp;nbsp; 노드 안의 코드 묶음. task의 TaskManager · TaskPlanner · DesignChecker, web의 DesignGenerator · DesignStore, bridge의 MqttBridge" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="180.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_3" value="&lt;b&gt;컨테이너&lt;/b&gt;&amp;nbsp;&amp;nbsp; Docker 상자(웹 PC compose). 성능은 그대로, 필요한 것만. mosquitto · db · web" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="218.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_4" value="&lt;b&gt;MQTT · 다리&lt;/b&gt;&amp;nbsp;&amp;nbsp; PC 사이 통신. 웹 PC 브로커(mosquitto) ↔ 로봇 PC 다리(bridge)가 ROS ↔ MQTT를 바꾼다. 토픽 d2/…, 요청 …/req · 응답 …/res + req_id, 상태 retained, 생존 신호 alive" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="256.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_5" value="&lt;b&gt;블록 JSON · 레시피&lt;/b&gt;&amp;nbsp;&amp;nbsp; 설계를 블록 목록(order · x · y · z · ori, mm)으로 적은 것 / 로봇이 쌓는 조립도 = 구조(cad_structure/1.0: 블록 이름 · 부품 · 자리) + 조립 방법(cad_recipe/1.0: 순서 · 잡기 · 받침). 블록 이름 = 역할_부품_블록(E-52). 변환기 ①②③이 바꾼다" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="294.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_6" value="&lt;b&gt;토픽&lt;/b&gt;&amp;nbsp;&amp;nbsp; 방송 — 보내고 끝, 답 없음. 여러 곳이 계속 봐야 하는 상태 · 진행표" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="332.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_7" value="&lt;b&gt;서비스&lt;/b&gt;&amp;nbsp;&amp;nbsp; 부탁 → 답 한 번. 짧은 일(명령 · 확인 · 그리퍼)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="370.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_8" value="&lt;b&gt;액션&lt;/b&gt;&amp;nbsp;&amp;nbsp; 부탁 → 중간 보고 → 결과, 도중 취소 가능. 블록 1개 옮기기" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="408.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4n" value="서비스 · 액션 화살표는 부탁하는 방향으로만 그렸다. 답은 같은 길로 돌아온다." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="2200.0" y="446.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="layer_svc" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fbf3ea;strokeColor=#b36b00;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="30.0" y="480.0" width="7814.0" height="1166.0" as="geometry"/></mxCell><mxCell id="layer_svc_t" value="&lt;b&gt;웹 PC — ROS 2 없음 · compose 3개(mosquitto 1883 / db PostgreSQL 16 / web = backend FastAPI :8000 + frontend 정적(브라우저 실행)) + 호스트 음성 voice.py · 로봇 PC와 MQTT(유선 LAN)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b36b00;strokeColor=none;fontColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="480.0" width="2100.0" height="38.0" as="geometry"/></mxCell><mxCell id="layer_robot" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#eef1fb;strokeColor=#3b5bb5;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="30.0" y="2064.0" width="7814.0" height="1578.0" as="geometry"/></mxCell><mxCell id="layer_robot_t" value="&lt;b&gt;로봇 PC — ROS 2 노드 전부, 컨테이너 없이 호스트 · CycloneDDS 60은 이 PC 안에서만 · 다리(bridge)가 MQTT ↔ ROS 변환 · 제어기와 유선 · 손목 카메라 USB&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b5bb5;strokeColor=none;fontColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="2064.0" width="2100.0" height="38.0" as="geometry"/></mxCell><mxCell id="layer_dev" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ecf6f0;strokeColor=#2e8b7a;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="30.0" y="3826.0" width="7814.0" height="160.0" as="geometry"/></mxCell><mxCell id="layer_dev_t" value="&lt;b&gt;로봇 · 장치 · 바깥 서비스 (노드 아님)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e8b7a;strokeColor=none;fontColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="3826.0" width="2100.0" height="38.0" as="geometry"/></mxCell><mxCell id="ctr_web" value="&lt;b&gt;[Docker] web — 컨테이너 하나 = backend(FastAPI :8000) 한 프로세스. frontend는 정적 out/로 담겨 브라우저에서 실행(Node 없음) · 만듦: 황인재&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#1565c0;strokeWidth=2.5;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="168.0" y="532.0" width="2278.0" height="876.0" as="geometry"/></mxCell><mxCell id="ctr_mqtt" value="&lt;b&gt;[Docker] mosquitto — MQTT 브로커 1883 · 만듦: 황인재&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#1565c0;strokeWidth=2.5;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="5158.0" y="532.0" width="474.0" height="124.0" as="geometry"/></mxCell><mxCell id="ctr_db" value="&lt;b&gt;[Docker] db — PostgreSQL 16 · 볼륨 pgdata · 만듦: 황인재&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#1565c0;strokeWidth=2.5;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="6555.0" y="532.0" width="444.0" height="124.0" as="geometry"/></mxCell><mxCell id="mqtt" value="&lt;b&gt;[저장소] mosquitto — MQTT 브로커 (1883, 웹 PC 컨테이너)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;웹 PC ↔ 로봇 PC 사이 모든 MQTT 화살표가 여기를 거친다 · 토픽 d2/… · 요청 …/req · 응답 …/res · 상태 retained · 유선 LAN 안&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="5180.0" y="566.0" width="430.0" height="74.0" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;[저장소] db — PostgreSQL 16 (designs · builds, JSONB)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;확정 10/6 E-39 · 볼륨 pgdata · db/init/001_schema.sql 첫 실행 때 자동 · web만 접근 · 1단계(10/7)는 JSON 파일 폴더&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="6577.0" y="566.0" width="400.0" height="74.0" as="geometry"/></mxCell><mxCell id="devops" value="&lt;b&gt;[라이브러리] 개발 도구 — Docker compose(컨테이너 3개 묶어 실행) · GitHub Actions(CI: backend pytest · frontend build · PR 검사)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;실행 구성 아님 · 노드 아님 · 그림의 화살표 없음&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="6577.0" y="1542.0" width="640.0" height="74.0" as="geometry"/></mxCell><mxCell id="recipe_tool" value="&lt;b&gt;[라이브러리] 레시피 도구 — CAD → 레시피 두 파일(구조 · 조립) · 변환기 ①(blocks_to_recipe)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;라이브러리(노드 아님) · 한세교 · DesignChecker가 import 해서 쓴다 · 로봇 PC&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1372.0" y="3538.0" width="520.0" height="74.0" as="geometry"/></mxCell><mxCell id="voice_stop" value="&lt;b&gt;[노드(나중에)] voice_stop — 음성 &#x27;멈춰&#x27; (나중에)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;PC 안 키워드 → MQTT d2/safety/stop/req → 다리 → safety/stop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="3391.0" y="1542.0" width="400.0" height="74.0" as="geometry"/></mxCell><mxCell id="bringup" value="&lt;b&gt;[이미 있는 노드] 브링업 — 이미 있는 노드들: 두산 드라이버 · dsr_moveit_controller · MoveIt2 move_group&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;설치해서 쓴다(우리가 만들지 않음) · d2_bringup launch · /joint_states · 로봇 알람&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3e7ec;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3736.0" y="3538.0" width="4018.0" height="74.0" as="geometry"/></mxCell><mxCell id="dev_person" value="&lt;b&gt;[장치] 사람 — 브라우저 · 키보드 · 펜던트&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;펜던트 비상정지는 늘 작동 · 출발 · 스캔 · 계속 버튼을 누르기 전에 영역 밖인지 확인&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190.0" y="3882.0" width="420.0" height="74.0" as="geometry"/></mxCell><mxCell id="openai" value="&lt;b&gt;[장치] OpenAI API — GPT-4o(설계 생성 · 의도) · Whisper(STT)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;인터넷 · 키는 웹 PC .env(env_file) · 코드 · 기록에 키 없음 · 학습 없음&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3391.0" y="3882.0" width="440.0" height="74.0" as="geometry"/></mxCell><mxCell id="dev_mic" value="&lt;b&gt;[장치] 마이크&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;웹 PC USB (호스트 voice.py)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="5995.0" y="3882.0" width="240.0" height="74.0" as="geometry"/></mxCell><mxCell id="dev_d435" value="&lt;b&gt;[장치] 손목 카메라 D435i (깊이)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;로봇 PC USB · 배치 확인 · 스캔 점군&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2624.0" y="3882.0" width="320.0" height="74.0" as="geometry"/></mxCell><mxCell id="dev_ctrl" value="&lt;b&gt;[장치] M0609 제어기 (DRCF)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;두산 안전 설정: 작업 공간 제한 · TCP 속도 · 충돌 감지 100 %&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="5535.0" y="3882.0" width="420.0" height="74.0" as="geometry"/></mxCell><mxCell id="dev_rg2" value="&lt;b&gt;[장치] OnRobot RG2 그리퍼&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;10 N&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="6275.0" y="3882.0" width="300.0" height="74.0" as="geometry"/></mxCell><mxCell id="frontend" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190.0" y="566.0" width="972.0" height="339.0" as="geometry"/></mxCell><mxCell id="frontend.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;frontend — 화면 (브라우저에서 실행 · Next.js 정적 + three.js)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="190.0" y="566.0" width="972.0" height="50.0" as="geometry"/></mxCell><mxCell id="frontend.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="578.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="frontend.meta" value="HMI · 패키지 web/frontend&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#1565c0&quot;&gt;돌리는 곳: 컨테이너 web&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="802.0" y="570.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="frontend.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="200.0" y="620.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="frontend.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="456.0" y="620.0" width="440.0" height="22.0" as="geometry"/></mxCell><mxCell id="frontend.col752" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="942.0" y="620.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="frontend.grp0" value="&lt;b&gt;컴포넌트 6개 — 글상자 · 트리 · 3D 미리보기 · 로봇 패널 · 스캔 비교 · 연결 표시&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="450.0" y="646.0" width="452.0" height="241.0" as="geometry"/></mxCell><mxCell id="frontend.in0" value="&lt;b&gt;사람 — 버튼 · 글상자&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;설계 선택 · 글상자 [생성] · 출발 · 정지 · 다시 시작 · [스캔] · [계속] · 스캔 비교 [저장] · [다시 스캔]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="646.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="frontend.in1" value="&lt;b&gt;REST 응답 (backend)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;설계 목록 · 상세(블록 JSON) · 버전 트리 · 검사 결과 · 생성 결과 · 명령 결과&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="727.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="frontend.in2" value="&lt;b&gt;WebSocket /ws (backend)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;상태 · 진행표 · 알림 · 쥔 블록 · 연결 상태 · 음성 요청 문장&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="808.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="frontend.out0" value="&lt;b&gt;REST 요청 → backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;GET · POST /api/designs · /api/robot (HTTP :8000)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="942.0" y="646.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="frontend.out1" value="&lt;b&gt;사람 — 화면&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;미리보기 · 트리 · 비교 · 진행표 · 알림 · 연결 상태&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;ht