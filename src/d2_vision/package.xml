<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>d2_vision</name>
  <version>0.0.1</version>
  <description>D2 비전 — 웹캠 사람 감지, 손목 손 찾기, 손목 블록 인식 (+ 가짜 노드 mock_*)</description>
  <maintainer email="gkstjrgud19@gmail.com">한석형</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>        <!-- wrist_block: 깊이 영상 · camera_info -->
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>d2_interfaces</exec_depend>      <!-- CheckProgress -->
  <exec_depend>d2_motion</exec_depend>          <!-- motion_math.recipe_blocks: 레시피 → base 블록 목록 (노드에서만 import, 시험은 안 씀) -->
  <exec_depend>dsr_msgs2</exec_depend>          <!-- 두산 posx · TCP 조회 (로봇 PC에만 있음 — CI 는 d2_vision 을 빌드만 한다) -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
