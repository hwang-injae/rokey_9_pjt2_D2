<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>d2_vision</name>
  <version>0.0.1</version>
  <description>D2 비전 — 웹캠 사람 감지, 손목 손 찾기, 손목 블록 인식 (+ 가짜 노드 mock_*)</description>
  <maintainer email="gkstjrgud19@gmail.com">한석형</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>        <!-- wrist_block: 깊이 영상 · camera_info -->
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>d2_interfaces</exec_depend>      <!-- CheckProgress -->
  <!-- d2_motion(motion_math.recipe_blocks: 레시피 → base 블록 목록)도 wrist_block · mock_wrist_block 이 쓰지만, 같은 이유(CI rosdep 이
       d2_motion 을 못 찾음 — from-paths 에 없음)로 적지 않는다. 시험(pytest)은 d2_motion 을 import 하지 않는다 -->
  <!-- dsr_msgs2(두산 posx · TCP 조회)도 wrist_block · capture_scene 이 쓰지만 적지 않는다: CI(ros-base 컨테이너)의 rosdep 이
       두산 패키지를 못 찾아 실패한다(10/7). 로봇 PC에는 두산 워크스페이스가 있어 실행에는 문제없다. CI rosdep 에 skip-keys 가 들어가면 다시 적는다 -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
