<?xml version="1.0"?>
<!-- M0609 + RG2 + 브라켓 + D435 용 SRDF (task3_demo). 팔 부분은 dsr.srdf.xacro 와 같다. -->
<robot name="m0609_rg2_camera">
  <!-- 팔: 끝을 손가락 끝 TCP(rg2_tcp)로 두어 IK 목표를 손가락 끝 기준으로 준다 -->
  <group name="manipulator">
    <chain base_link="base_link" tip_link="rg2_tcp"/>
  </group>
  <group name="gripper">
    <joint name="rg2_finger_joint"/>
  </group>
  <group_state name="home" group="manipulator">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="1.5708"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="1.5708"/>
    <joint name="joint_6" value="0"/>
  </group_state>
  <end_effector name="rg2" parent_link="rg2_tcp" group="gripper" parent_group="manipulator"/>
  <virtual_joint name="FixedBase" type="fixed" parent_frame="world" child_link="base_link"/>
  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_1" link2="link_3" reason="Never"/>
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_2" link2="link_5" reason="Never"/>
  <disable_collisions link1="link_2" link2="link_6" reason="Never"/>
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_3" link2="link_5" reason="Never"/>
  <disable_collisions link1="link_3" link2="link_6" reason="Never"/>
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_4" link2="link_6" reason="Never"/>
  <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="bracket_link" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="rg2_base_link" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="rg2_left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="rg2_left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="rg2_left_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="rg2_right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="rg2_right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="rg2_right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="bracket_link" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="bracket_link" link2="rg2_base_link" reason="Adjacent"/>
  <disable_collisions link1="bracket_link" link2="rg2_left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="bracket_link" link2="rg2_left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="bracket_link" link2="rg2_left_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="bracket_link" link2="rg2_right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="bracket_link" link2="rg2_right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="bracket_link" link2="rg2_right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="rg2_base_link" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="rg2_left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="rg2_left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="rg2_left_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="rg2_right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="rg2_right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="rg2_right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="rg2_base_link" link2="rg2_left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_base_link" link2="rg2_left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_base_link" link2="rg2_left_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="rg2_base_link" link2="rg2_right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_base_link" link2="rg2_right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_base_link" link2="rg2_right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_outer_knuckle" link2="rg2_left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_outer_knuckle" link2="rg2_left_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_outer_knuckle" link2="rg2_right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_outer_knuckle" link2="rg2_right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_outer_knuckle" link2="rg2_right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_inner_knuckle" link2="rg2_left_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_inner_knuckle" link2="rg2_right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_inner_knuckle" link2="rg2_right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_inner_knuckle" link2="rg2_right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_inner_finger" link2="rg2_right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_inner_finger" link2="rg2_right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_left_inner_finger" link2="rg2_right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="rg2_right_outer_knuckle" link2="rg2_right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg2_right_outer_knuckle" link2="rg2_right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="rg2_right_inner_knuckle" link2="rg2_right_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="link_5" link2="bracket_link" reason="Never"/>
  <disable_collisions link1="link_5" link2="rg2_base_link" reason="Never"/>
</robot>
